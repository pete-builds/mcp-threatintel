# abuse.ch Auth-Key (free: register at https://auth.abuse.ch/, generate key in profile)
ABUSECH_API_KEY=your_abusech_auth_key_here

# AlienVault OTX API key (free: https://otx.alienvault.com/)
OTX_API_KEY=your_otx_api_key_here

# LeakCheck API key ($10/mo: https://leakcheck.io/)
LEAKCHECK_API_KEY=your_leakcheck_api_key_here

# Have I Been Pwned API key ($4.50/mo: https://haveibeenpwned.com/API/Key)
# Optional. Required only for check_email_breaches. Password checks are always free.
HIBP_API_KEY=your_hibp_api_key_here

# Database path (inside container, mounted volume)
DB_PATH=/data/threatintel.db

# Bearer token for the HTTP transport. REQUIRED. The server refuses to start
# over HTTP without it, and every client must send `Authorization: Bearer <token>`.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# It belongs in .env on the host only (chmod 600 .env): never in
# docker-compose.yml and never in git. Left blank, as it ships here, the server
# exits at startup with "Bearer token required".
# MCP_THREATINTEL_AUTH_TOKEN is the older name for the same token. It is still
# accepted and it wins if both are set, so set one of them, not both.
MCP_AUTH_TOKEN=
